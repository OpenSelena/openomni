{
  "name": "open-omni",
  "version": "1.0.0",
  "description": "Smart, lightweight, and modern CLI video, audio, and photo downloader powered by yt-dlp & gallery-dl",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "openomni": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "clean:temp": "node scripts/clean-temp.js",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "author": {
    "name": "Igect",
    "url": "https://igect.link/"
  },
  "keywords": [
    "cli",
    "ytdlp",
    "downloader",
    "video",
    "audio",
    "music",
    "youtube",
    "ink",
    "terminal"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "dotenv": "^17.3.1",
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "meow": "^13.2.0",
    "react": "^18.3.1",
    "terminal-link": "^3.0.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.5",
    "@types/node": "^20.11.24",
    "@types/react": "^18.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.3.3"
  }
}
